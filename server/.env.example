# =============================================================================
# Conexão da API com o PostgreSQL
#
# Copie este arquivo para `server/.env` e preencha com as SUAS credenciais.
# O arquivo `.env` é ignorado pelo Git — nunca comite senhas reais.
# =============================================================================

# Opção A — variáveis separadas (recomendado quando a senha tem caracteres
# especiais como @, :, / que precisariam ser codificados numa URL).
#
# IMPORTANTE: estes valores batem com o que os scripts de desenvolvimento criam
# — tanto `scripts/postgres.sh init` (sem Docker) quanto o container Docker
# sugerido em docs/banco-de-dados.md usam o usuário e o banco `conecta` com
# autenticação `trust` (SEM senha). Deixe PGPASSWORD vazio nesse cenário.
PGHOST=localhost
PGPORT=5432
PGDATABASE=conecta
PGUSER=conecta
PGPASSWORD=

# Opção B — URL completa (tem precedência sobre as variáveis acima, se definida).
# Caracteres especiais na senha devem ser percent-encoded (ex.: @ vira %40).
# DATABASE_URL=postgres://conecta@localhost:5432/conecta

# Porta do servidor HTTP da API
PORT=3001

# -----------------------------------------------------------------------------
# Segurança (autenticação)
# -----------------------------------------------------------------------------
# Segredo para assinar os tokens JWT. Use um valor longo e aleatório em produção.
JWT_SECRET=troque-por-um-segredo-forte-e-aleatorio
# Validade do token (ex.: 7d, 12h, 3600). Opcional.
JWT_EXPIRES_IN=7d
# Custo do bcrypt (quanto maior, mais lento e seguro). Opcional (padrão 10).
BCRYPT_ROUNDS=10

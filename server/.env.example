# =============================================================================
# Conexão da API com o PostgreSQL
#
# Copie este arquivo para `server/.env` e preencha com as SUAS credenciais.
# O arquivo `.env` é ignorado pelo Git — nunca comite senhas reais.
# =============================================================================

# Opção A — variáveis separadas (recomendado quando a senha tem caracteres
# especiais como @, :, / que precisariam ser codificados numa URL).
PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=sua-senha-aqui

# Opção B — URL completa (tem precedência sobre as variáveis acima, se definida).
# Caracteres especiais na senha devem ser percent-encoded (ex.: @ vira %40).
# DATABASE_URL=postgres://postgres:sua%2Dsenha@localhost:5432/postgres

# Porta do servidor HTTP da API
PORT=3001

# Porta HTTP do backend
PORT=4000

# Segredo do JWT (use um valor forte e secreto em produção)
CONECTA_JWT_SECRET=troque-por-um-segredo-forte

# Chave para criptografar em repouso o bloco sensível do candidato (NF2 / LGPD).
# Em produção, use um gerenciador de segredos/KMS.
CONECTA_SENSITIVE_KEY=troque-por-uma-chave-forte

# (Opcional) Caminho do arquivo SQLite e do diretório de dados.
# CONECTA_DB_FILE=./data/conecta.sqlite
# CONECTA_DATA_DIR=./data

{
  "name": "conecta-inclusao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plataforma de empregos inclusiva para Pessoas com Deficiência (PcD) — acessível, com tema claro/escuro e navegação guiada.",
  "scripts": {
    "setup": "npm install && npm run api:install",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "ensure:api-deps": "node scripts/ensure-api-deps.mjs",
    "preapi": "npm run ensure:api-deps",
    "api": "npm --prefix server run start",
    "api:install": "npm --prefix server install",
    "predb:reset": "npm run ensure:api-deps",
    "db:reset": "npm --prefix server run db:reset",
    "predb:migrate": "npm run ensure:api-deps",
    "db:migrate": "npm --prefix server run db:migrate",
    "predb:seed": "npm run ensure:api-deps",
    "db:seed": "npm --prefix server run db:seed",
    "pretest:api": "npm run ensure:api-deps",
    "test:api": "npm --prefix server test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
